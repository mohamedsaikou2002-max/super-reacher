# Client-visible Supabase project configuration (publishable key is not a secret).
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only Supabase configuration. Never prefix service role credentials with VITE_.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mandatory for BYO API credential encryption; 32 random bytes, base64 encoded.
# Generate on a trusted server: openssl rand -base64 32
# Store in the hosting provider's secret manager. Back up and rotate with re-encryption.
INTEGRATION_VAULT_KEY=""

# AI providers; configure only providers in use and only as server secrets.
LOVABLE_API_KEY=""
GROQ_API_KEY=""
# xAI Grok (distinct from GROQ); powers the Research sourcing assistant.
XAI_API_KEY=""
XAI_MODEL="grok-4.7"
GEMINI_API_KEY=""
COMPANIES_HOUSE_API_KEY=""
APOLLO_API_KEY=""
HUNTER_API_KEY=""
# Firecrawl legacy connector (optional; no longer used by the main Scrapy queue).
FIRECRAWL_API_KEY=""
INSEE_API_KEY=""

# Optional research routing. TOR mode requires a verified compatible proxy transport.
RESEARCH_EGRESS_MODE="DIRECT"
TOR_SOCKS_PROXY_URL="socks5h://127.0.0.1:9050"

# Security: comma-separated exact trusted DNS hosts, never private IPs/localhost.
# The application denies self-hosted engine and direct research egress by default.
SELF_HOSTED_ENGINE_ALLOWED_HOSTS=""
SELF_HOSTED_ENGINE_API_KEY=""
RESEARCH_ALLOWED_HOSTS=""

# Approved, capped single-message sending only; OFF by default. Never store secrets in Git.
# Select "brevo" or "resend"; this does not enable bulk marketing campaigns.
OUTBOUND_PROVIDER="brevo"
BREVO_API_KEY=""
BREVO_FROM_ADDRESS=""
OUTBOUND_ENABLED="false"
OUTBOUND_APPROVED_USERS=""
RESEND_API_KEY=""
RESEND_FROM_ADDRESS=""
RESEND_WEBHOOK_SECRET=""
UNSUBSCRIBE_SIGNING_SECRET=""
PUBLIC_APP_URL=""

# A separate trusted Scrapy worker needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# The local worker must be launched explicitly and is not hosted by the browser.
# Muse custom bridge is NOT active without verified Meta connector support.
