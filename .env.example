# Client-visible Supabase project configuration (publishable key is not a secret).
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only Supabase configuration. Never prefix service role credentials with VITE_.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mandatory for BYO API credential encryption; 32 random bytes, base64 encoded.
# Generate on a trusted server: openssl rand -base64 32
# Store in the hosting provider's secret manager. Back up and rotate with re-encryption.
INTEGRATION_VAULT_KEY=""

# AI providers; configure only providers in use and only as server secrets.
LOVABLE_API_KEY=""
GROQ_API_KEY=""
COMPANIES_HOUSE_API_KEY=""
APOLLO_API_KEY=""
HUNTER_API_KEY=""
FIRECRAWL_API_KEY=""
INSEE_API_KEY=""

# Optional research routing. TOR mode requires a verified compatible proxy transport.
RESEARCH_EGRESS_MODE="DIRECT"
TOR_SOCKS_PROXY_URL="socks5h://127.0.0.1:9050"

# Security: comma-separated exact trusted DNS hosts, never private IPs/localhost.
# The application denies self-hosted engine and direct research egress by default.
SELF_HOSTED_ENGINE_ALLOWED_HOSTS=""
SELF_HOSTED_ENGINE_API_KEY=""
RESEARCH_ALLOWED_HOSTS=""

# Explicit single-email sending, off by default. Never store secrets in Git.
OUTBOUND_ENABLED="false"
OUTBOUND_APPROVED_USERS=""
RESEND_API_KEY=""
RESEND_FROM_ADDRESS=""
RESEND_WEBHOOK_SECRET=""
UNSUBSCRIBE_SIGNING_SECRET=""
PUBLIC_APP_URL=""
